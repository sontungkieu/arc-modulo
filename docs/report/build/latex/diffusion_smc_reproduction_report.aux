\newlabel{fig:das-primary}{{1}{4}{DAS primary diagnostics. Dots là seed; dấu X đỏ là point estimate paper; diamond xanh là mean reproduction. Panel (c) dùng error bar là SD do 5 lần subsample 500 điểm trong cùng seed. Trục log dùng để chứa approximate guidance mà không che các method còn lại}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mode fidelity. Heatmap cho thấy mass gán vào 9 tâm GMM; panel phải tách mode-mass L1 và mass nằm ngoài các target-active mode. Màu không được dùng một mình: mỗi ô có giá trị số và mỗi bar có vị trí riêng.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:das-modes}{{2}{4}{Mode fidelity. Heatmap cho thấy mass gán vào 9 tâm GMM; panel phải tách mode-mass L1 và mass nằm ngoài các target-active mode. Màu không được dùng một mình: mỗi ô có giá trị số và mỗi bar có vị trí riêng}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Phân phối target và các seed DAS tốt/median/tồi theo EMD. Đây là visual diagnostic bổ trợ; verdict vẫn dựa trên metrics định trước.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:das-samples}{{3}{5}{Phân phối target và các seed DAS tốt/median/tồi theo EMD. Đây là visual diagnostic bổ trợ; verdict vẫn dựa trên metrics định trước}{figure.3}{}}
