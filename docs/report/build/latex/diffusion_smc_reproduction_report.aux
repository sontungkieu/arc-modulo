\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sai khác tương đối giữa scaled reproduction và Table A1. Màu được clip ở $\pm 200\%$ để tránh một cell chi phối; con số annotation giữ giá trị thực. Vì mọi metric đều lower-is-better, giá trị dương là reproduction xấu hơn paper.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:fkc-error}{{5}{6}{Sai khác tương đối giữa scaled reproduction và Table A1. Màu được clip ở $\pm 200\%$ để tránh một cell chi phối; con số annotation giữ giá trị thực. Vì mọi metric đều lower-is-better, giá trị dương là reproduction xấu hơn paper}{figure.5}{}}
